; COPY PASTE THIS FILE INTO  a file named platform.ini after entering your SSID and password.

[env:a_name]
platform = espressif32
board = esp32dev
framework = arduino
monitor_speed = 115200
lib_deps = 
	h2zero/NimBLE-Arduino @ ^1.4.2
	fastled/FastLED@3.7.0
	makuna/NeoPixelBus@^2.8.3
	bblanchon/ArduinoJson@^7.2.0
build_flags = 
    '-D WIFI_SSID="your_ssid_here"'
    '-D WIFI_PASSWORD="your_password_here"'